<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="https://jakarta.ee/xml/ns/jakartaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee https://jakarta.ee/xml/ns/jakartaee/web-app_6_0.xsd"
         version="6.0"
         metadata-complete="true">

    <filter>
        <filter-name>AuthenticationFilter</filter-name>
        <filter-class>edu.college.smartmatcher.web.AuthenticationFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthenticationFilter</filter-name>
        <url-pattern>/account</url-pattern>
        <url-pattern>/skills</url-pattern>
        <url-pattern>/projects</url-pattern>
        <url-pattern>/teammates</url-pattern>
        <url-pattern>/skill-gaps</url-pattern>
        <url-pattern>/team-balance</url-pattern>
        <url-pattern>/join</url-pattern>
        <url-pattern>/my-requests</url-pattern>
        <url-pattern>/invitations</url-pattern>
        <url-pattern>/team-management</url-pattern>
        <url-pattern>/my-teams</url-pattern>
        <url-pattern>/settings</url-pattern>
        <url-pattern>/search</url-pattern>
        <url-pattern>/admin</url-pattern>
        <url-pattern>/admin/*</url-pattern>
    </filter-mapping>

    <!-- Servlet declarations precede mappings as required by the Jakarta descriptor schema. -->
    <servlet>
        <servlet-name>AdminServlet</servlet-name>
        <servlet-class>edu.college.smartmatcher.web.AdminServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>HealthCheckServlet</servlet-name>
        <servlet-class>edu.college.smartmatcher.web.HealthCheckServlet</servlet-class>
        <load-on-startup>1</load-on-startup>
    </servlet>
    <servlet>
        <servlet-name>AuthServlet</servlet-name>
        <servlet-class>edu.college.smartmatcher.web.AuthServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>SettingsServlet</servlet-name>
        <servlet-class>edu.college.smartmatcher.web.SettingsServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>SkillServlet</servlet-name>
        <servlet-class>edu.college.smartmatcher.web.SkillServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>ProjectServlet</servlet-name>
        <servlet-class>edu.college.smartmatcher.web.ProjectServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>GlobalSearchServlet</servlet-name>
        <servlet-class>edu.college.smartmatcher.web.GlobalSearchServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>FindTeammatesServlet</servlet-name>
        <servlet-class>edu.college.smartmatcher.web.FindTeammatesServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>TeamAnalysisServlet</servlet-name>
        <servlet-class>edu.college.smartmatcher.web.TeamAnalysisServlet</servlet-class>
    </servlet>
    <servlet>
        <servlet-name>TeamWorkflowServlet</servlet-name>
        <servlet-class>edu.college.smartmatcher.web.TeamWorkflowServlet</servlet-class>
    </servlet>

    <servlet-mapping>
        <servlet-name>AdminServlet</servlet-name>
        <url-pattern>/admin</url-pattern>
        <url-pattern>/admin/*</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>HealthCheckServlet</servlet-name>
        <url-pattern>/health</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>AuthServlet</servlet-name>
        <url-pattern>/register</url-pattern>
        <url-pattern>/login</url-pattern>
        <url-pattern>/logout</url-pattern>
        <url-pattern>/account</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>SettingsServlet</servlet-name>
        <url-pattern>/settings</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>SkillServlet</servlet-name>
        <url-pattern>/skills</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>ProjectServlet</servlet-name>
        <url-pattern>/projects</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>GlobalSearchServlet</servlet-name>
        <url-pattern>/search</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>FindTeammatesServlet</servlet-name>
        <url-pattern>/teammates</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>TeamAnalysisServlet</servlet-name>
        <url-pattern>/skill-gaps</url-pattern>
        <url-pattern>/team-balance</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>TeamWorkflowServlet</servlet-name>
        <url-pattern>/join</url-pattern>
        <url-pattern>/my-requests</url-pattern>
        <url-pattern>/invitations</url-pattern>
        <url-pattern>/team-management</url-pattern>
        <url-pattern>/my-teams</url-pattern>
    </servlet-mapping>
</web-app>
