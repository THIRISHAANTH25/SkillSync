<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.List, edu.college.smartmatcher.web.TeamWorkflowServlet, edu.college.smartmatcher.web.TeamWorkflowServlet.LeaderProjectView, edu.college.smartmatcher.web.TeamWorkflowServlet.ApplicantView, edu.college.smartmatcher.web.TeamWorkflowServlet.MemberView" %>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
    <script src="${pageContext.request.contextPath}/assets/theme.js?v=20261029-universal-login"></script>
    <title>Team Leader Management | Smart Project Team Matcher</title>
    <link rel="icon" type="image/png" href="${pageContext.request.contextPath}/assets/skillsync-favicon.png?v=20261018-phase1">
    <link rel="stylesheet" href="${pageContext.request.contextPath}/assets/theme.css?v=20261029-universal-login">
</head><body><div class="shell"><header class="topbar"><strong>Smart Project Team Matcher</strong><span>Student workspace</span></header>
<jsp:include page="/WEB-INF/sidebar.jsp"><jsp:param name="active" value="team-management"/></jsp:include>
<main><h1>Team Leader Management</h1><p class="intro">As project creator, review requests, choose teammates, and monitor capacity.</p>
<% if(request.getAttribute("notice")!=null){ %><p class="message" role="status"><%= TeamWorkflowServlet.escapeHtml((String)request.getAttribute("notice")) %></p><% } %><% if(request.getAttribute("error")!=null){ %><p class="error" role="alert"><%= TeamWorkflowServlet.escapeHtml((String)request.getAttribute("error")) %></p><% } %>
<% List<LeaderProjectView> projects=(List<LeaderProjectView>)request.getAttribute("projects"); if(projects==null||projects.isEmpty()){ %><p class="empty">You have not created any projects yet.</p><% } else { for(LeaderProjectView project:projects){ %>
<section class="project leader-project"><div class="project-head"><h2><%= TeamWorkflowServlet.escapeHtml(project.getTitle()) %></h2><span class="status-badge status-<%= project.getStatus().toLowerCase(java.util.Locale.ROOT) %>"><%= TeamWorkflowServlet.displayStatus(project.getStatus()) %></span></div><p class="meta"><%= project.getOccupiedSlots() %> / <%= project.getCapacity() %> slots filled · <%= project.getOpenSlots() %> available</p><div class="capacity-meter" role="progressbar" aria-label="Team capacity" aria-valuemin="0" aria-valuemax="<%= project.getCapacity() %>" aria-valuenow="<%= project.getOccupiedSlots() %>" style="--capacity-value:<%= (project.getOccupiedSlots() * 100 / project.getCapacity()) %>%"><span></span></div>
<div class="grid"><section class="panel"><h3>Selected team members</h3><% if(project.getMembers().isEmpty()){ %><p class="empty">No team members yet.</p><% } else { for(MemberView member:project.getMembers()){ %><article class="person"><strong><%= TeamWorkflowServlet.escapeHtml(member.getFullName()) %></strong> <span class="badge"><%= TeamWorkflowServlet.displayStatus(member.getRole()) %></span><p class="meta"><%= TeamWorkflowServlet.escapeHtml(member.getDepartment()) %> · Year <%= member.getYear() %></p></article><% } } %></section>
<section class="panel"><h3>Join requests</h3><% if(project.getApplicants().isEmpty()){ %><p class="empty">No requests for this project.</p><% } else { for(ApplicantView applicant:project.getApplicants()){ %><article class="person applicant-card"><div><strong><%= TeamWorkflowServlet.escapeHtml(applicant.getFullName()) %></strong> <span class="status-badge status-<%= applicant.getStatus().toLowerCase(java.util.Locale.ROOT) %>"><%= TeamWorkflowServlet.displayStatus(applicant.getStatus()) %></span><p class="meta"><%= TeamWorkflowServlet.escapeHtml(applicant.getDepartment()) %> · Year <%= applicant.getYear() %> · Requested <%= TeamWorkflowServlet.escapeHtml(applicant.getDate()) %></p><p><strong>Match:</strong> <%= String.format(java.util.Locale.ROOT,"%.2f",applicant.getMatchPercent()) %>%</p><div class="match-meter" role="progressbar" aria-label="Applicant match percentage" aria-valuemin="0" aria-valuemax="100" aria-valuenow="<%= String.format(java.util.Locale.ROOT,"%.2f",applicant.getMatchPercent()) %>" style="--match-value:<%= applicant.getMatchPercent() %>%"><span></span></div><p><strong>Matching skills and proficiency:</strong> <%= applicant.getSkills()==null||applicant.getSkills().isBlank()?"No required skills matched":TeamWorkflowServlet.escapeHtml(applicant.getSkills()) %></p><% if(applicant.getMessage()!=null&&!applicant.getMessage().isBlank()){ %><p><strong>Message:</strong> <%= TeamWorkflowServlet.escapeHtml(applicant.getMessage()) %></p><% } %></div>
<% if("OPEN".equals(project.getStatus())&&("PENDING".equals(applicant.getStatus())||"SHORTLISTED".equals(applicant.getStatus()))){ %><div class="actions"><% if("PENDING".equals(applicant.getStatus())){ %><form method="post" action="${pageContext.request.contextPath}/team-management"><input type="hidden" name="application_id" value="<%= applicant.getApplicationId() %>"><input type="hidden" name="decision" value="shortlisted"><button class="secondary" type="submit">Shortlist</button></form><% } %><form method="post" action="${pageContext.request.contextPath}/team-management"><input type="hidden" name="application_id" value="<%= applicant.getApplicationId() %>"><input type="hidden" name="decision" value="accepted"><button type="submit">Accept</button></form><form method="post" action="${pageContext.request.contextPath}/team-management"><input type="hidden" name="application_id" value="<%= applicant.getApplicationId() %>"><input type="hidden" name="decision" value="rejected"><button class="secondary" type="submit">Reject</button></form></div><% } %></article><% } } %></section></div></section>
<% } } %></main></div></body></html>
