<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.List, edu.college.smartmatcher.web.TeamWorkflowServlet, edu.college.smartmatcher.web.TeamWorkflowServlet.JoinedTeamView" %>
<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1">
    <script src="${pageContext.request.contextPath}/assets/theme.js?v=20261029-universal-login"></script>
    <title>My Teams | Smart Project Team Matcher</title>
    <link rel="icon" type="image/png" href="${pageContext.request.contextPath}/assets/skillsync-favicon.png?v=20261018-phase1">
    <link rel="stylesheet" href="${pageContext.request.contextPath}/assets/theme.css?v=20261029-universal-login">
</head><body><div class="shell"><header class="topbar"><strong>Smart Project Team Matcher</strong><span>Student workspace</span></header>
<jsp:include page="/WEB-INF/sidebar.jsp"><jsp:param name="active" value="my-teams"/></jsp:include>
<main><h1>My Teams</h1><p class="intro">Teams you have joined or lead.</p>
<% if(request.getAttribute("notice")!=null){ %><p class="message" role="status"><%= TeamWorkflowServlet.escapeHtml((String)request.getAttribute("notice")) %></p><% } %><% if(request.getAttribute("error")!=null){ %><p class="error" role="alert"><%= TeamWorkflowServlet.escapeHtml((String)request.getAttribute("error")) %></p><% } %>
<% List<JoinedTeamView> teams=(List<JoinedTeamView>)request.getAttribute("teams"); if(teams==null||teams.isEmpty()){ %><section class="empty-state"><span class="empty-state-icon" aria-hidden="true">✦</span><h2>No teams yet</h2><p>When a project leader accepts you, your team will appear here.</p><a href="${pageContext.request.contextPath}/projects">Explore Projects</a></section><% } else { for(JoinedTeamView team:teams){ %><article class="card team-card"><div class="project-head"><div><span class="eyebrow">PROJECT TEAM</span><h2><%= TeamWorkflowServlet.escapeHtml(team.getTitle()) %></h2></div><span class="status-badge status-active">Joined</span></div><p class="meta">Team leader: <strong><%= TeamWorkflowServlet.escapeHtml(team.getLeader()) %></strong> · Your role: <span class="badge"><%= TeamWorkflowServlet.displayStatus(team.getRole()) %></span></p><div class="team-capacity"><strong><%= team.getCapacity()-team.getOpenSlots() %> / <%= team.getCapacity() %></strong><span>slots filled</span><span class="capacity-meter" role="progressbar" aria-label="Team capacity" aria-valuemin="0" aria-valuemax="<%= team.getCapacity() %>" aria-valuenow="<%= team.getCapacity()-team.getOpenSlots() %>" style="--capacity-value:<%= (team.getCapacity()-team.getOpenSlots()) * 100 / team.getCapacity() %>%"><span></span></span><span><%= team.getOpenSlots() %> slots available · Joined <%= TeamWorkflowServlet.escapeHtml(team.getDate()) %></span></div></article><% } } %></main></div></body></html>
